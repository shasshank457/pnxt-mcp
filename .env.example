POINTNXT_BASE_URL=http://localhost:3001/v1
POINTNXT_ACCESS_TOKEN=<jwt-access-token>
POINTNXT_REFRESH_TOKEN=<jwt-refresh-token>
POINTNXT_REFRESH_ENDPOINT=/auth/refresh
POINTNXT_TENANT_ID=<tenant-id>
MCP_SESSION_ENCRYPTION_KEY=<base64url-encoded-32-byte-key>
MCP_SESSION_ENCRYPTION_REQUIRED=true
MCP_AUTH_RATE_LIMIT_IP=10
MCP_AUTH_RATE_LIMIT_TRANSACTION=5
MCP_AUTH_RATE_LIMIT_WINDOW=300
PNXT_ENABLE_WRITE_TOOLS=false
PNXT_WRITE_TOOLS_ALLOWLIST=
PNXT_CONFIRMATION_SECRET=<at-least-32-byte-secret-when-writes-enabled>
PNXT_CONFIRMATION_TTL_SECONDS=300
PNXT_WRITE_TIMEOUT_SECONDS=30
PNXT_WRITE_FREE_TEXT_MAX_LENGTH=1000
CIMD_ALLOWED_HOSTS=chatgpt.com,claude.ai,claude.com
OAUTH_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,https://chatgpt.com/connector_platform_oauth_redirect
CHATGPT_REDIRECT_URI=
